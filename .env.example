# Neon / Supabase / Vercel Postgres — use a pooled URL for serverless (often ends in ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Required for sessions (generate: openssl rand -base64 32)
SESSION_SECRET=""

# Storefront gate password (home page → shop). Also used when seeding.
DROP_PASSWORD="test101"
ADMIN_PASSWORD="admin"

# Local dev with docker compose: copy to .env and use:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pshop?connect_timeout=2"
# SESSION_SECRET="any-long-random-string"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Then: docker compose up -d && npm run db:migrate && npm run db:seed

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"
STRIPE_WEBHOOK_SECRET=""
